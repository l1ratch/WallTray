        <!-- Стиль для интерактивной карточки перехода в параметры -->
        <Style x:Key="SettingsCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1c1c1c"/>
            <Setter Property="BorderBrush" Value="#2b2b2b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3d3d3d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#171717"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для горизонтальных плиток списка -->
        <Style x:Key="ThumbnailItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="1" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для круглых кнопок управления в шапке -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBrd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBrd" Property="Background" Value="#2d2d2d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка нижнего докера навигации -->
        <Style x:Key="DockNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#787878"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Фоновый pill с легким скруглением -->
                            <Border x:Name="pill"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="1,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover неактивной кнопки -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#1f1f1f"/>
                                <Setter TargetName="pill" Property="BorderBrush" Value="#2f2f2f"/>
                                <Setter Property="Foreground" Value="#d4d4d4"/>
                            </Trigger>
                            <!-- Активная кнопка страницы (Tag == True) -->
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#1f1f1f"/>
                                <Setter TargetName="pill" Property="BorderBrush" Value="#2f2f2f"/>
                                <Setter Property="Foreground" Value="#52a9ff"/>
                            </DataTrigger>
                            <!-- Hover активной кнопки -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="pill" Property="Background" Value="#262626"/>
                                <Setter TargetName="pill" Property="BorderBrush" Value="#3a3a3a"/>
                                <Setter Property="Foreground" Value="#72c2ff"/>
                            </MultiDataTrigger>
                            <!-- Нажатие (Pressed) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#181818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="RoundIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#b0b0b0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="roundButton" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="roundButton" Property="Background" Value="#383838"/>
                                <Setter TargetName="roundButton" Property="BorderBrush" Value="#505050"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="roundButton" Property="Background" Value="#1c1c1c"/>
                                <Setter TargetName="roundButton" Property="BorderBrush" Value="#282828"/>
                                <Setter Property="Foreground" Value="#d0d0d0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общий стиль для кнопок (с кастомным шаблоном, чтобы не было дефолтных засветов Windows) -->
        <Style x:Key="FluentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3d3d3d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1d1d1d"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Стиль для первичных (акцентных) кнопок -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentButtonStyle}">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1086e5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006cbe"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1d1d1d"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ScrollViewer в настройках с плавающим ScrollBar -->
        <Style x:Key="SettingsScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <!-- Контент занимает всю ширину -->
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                            
                            <!-- Тонкий плавающий ScrollBar поверх контента справа -->
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       HorizontalAlignment="Right"
                                       Width="6"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Cursor="Arrow"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для чекбоксов в настройках (Toggle Switch Windows 11) -->
        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" SnapsToDevicePixels="true">
                            <BulletDecorator.Bullet>
                                <Grid x:Name="SwitchRoot" Width="38" Height="20" Margin="0,0,10,0">
                                    <Border x:Name="BackgroundBorder" Background="#333333" CornerRadius="10" BorderBrush="#555555" BorderThickness="1"/>
                                    <Border x:Name="Thumb" Background="#ffffff" Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Left" Margin="3,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="0" Y="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter HorizontalAlignment="Left" Margin="0,1,0,0" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#f0f0f0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#0078d4"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#0078d4"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#ffffff"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="18" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#888888"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#0086f0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ComboBoxItem (элементов выпадающего списка) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBrd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBrd" Property="Background" Value="#3d3d3d"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBrd" Property="Background" Value="#0078d4"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#4d4d4d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Background="{TemplateBinding Background}" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Brd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" Margin="8,4" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="▼" FontSize="8" Foreground="#cccccc" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#353535"/>
                                                <Setter TargetName="Brd" Property="BorderBrush" Value="#666666"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="#202020" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Popup" Property="Height" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛИ ДЛЯ СКРОЛЛБАРА (ScrollBar) В СТИЛЕ WINDOWS 11 -->
        <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBrd" CornerRadius="3" Background="#444444" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBrd" Property="Background" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBrd" Property="Background" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для современного Expander в стиле Win11 -->
        <Style x:Key="ModernExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#2d2d2d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Заголовок с кнопкой раскрытия -->
                                <ToggleButton Grid.Row="0" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="14,12">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Собственно сам Header контент -->
                                                    <ContentPresenter Grid.Column="0" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/>
                                                    
                                                    <!-- Стрелка раскрытия (справа) -->
                                                    <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#aaaaaa" StrokeThickness="2" Width="10" Height="6" Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Stroke" Value="#ffffff"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                
                                <!-- Содержимое (выдвижная часть) -->
                                <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Visibility="Collapsed" Focusable="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленьких кнопок-тегов -->
        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderBrush" Value="#3d3d3d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,2,4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#353535"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Конвертер видимости из boolean -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <!-- Внешний контейнер с тенью и скруглением углов -->
    <Border Margin="10" Background="#181818" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.5" ShadowDepth="3" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Шапка -->
                <RowDefinition Height="*"/>    <!-- Содержимое страниц -->
                <RowDefinition Height="Auto"/> <!-- Нижняя навигация -->
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА -->
            <Grid Grid.Row="0" Margin="14,14,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Кнопка Назад -->
                    <ColumnDefinition Width="*"/>    <!-- Заголовок -->
                    <ColumnDefinition Width="Auto"/> <!-- Статус -->
                </Grid.ColumnDefinitions>

                <!-- Кнопка Назад (←) -->
                <Button Grid.Column="0" Style="{StaticResource HeaderButtonStyle}" Command="{Binding GoToGalleryCommand}" 
                        Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0">
                    <Path Data="{StaticResource IconBack}" Fill="#ffffff" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
                
                <!-- Заголовок страницы (везде WallTray, без версии) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="24" Height="24" Margin="0,0,8,0"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding ShowLogo, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding PageTitle}" Foreground="#ffffff" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Бейдж статуса (открывается при наведении, не кликается) -->
                <Border x:Name="StatusBadge" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Background="#202020" BorderBrush="#303030" BorderThickness="1"
                        CornerRadius="13" Padding="8,4" Cursor="Arrow"
                        MouseEnter="StatusBadge_MouseEnter" MouseLeave="StatusBadge_MouseLeave">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#292929"/>
                                    <Setter Property="BorderBrush" Value="#404040"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Цветной статус-индикатор (точка) -->
                        <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBadgeForeground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <!-- Крутящееся кольцо в состоянии занятости -->
                            <Ellipse x:Name="BusyRing" Width="14" Height="14" StrokeThickness="1.5" Opacity="0"
                                     Stroke="{Binding StatusBadgeForeground}" StrokeDashArray="3 2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="StatusIconRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding StatusBadgeText}" 
                                   Foreground="#d0d0d0" FontSize="11" FontWeight="Medium" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Встроенная панель статуса: полупрозрачная матовая карточка по наведению -->
            <Border x:Name="StatusPanel" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10" Width="268" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,46,14,0" Background="#ea1c1c1c" BorderBrush="#383838" BorderThickness="1" CornerRadius="12" Padding="12,10"
                    Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.9,0"
                    MouseEnter="StatusPopup_MouseEnter" MouseLeave="StatusPopup_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="22" Opacity="0.55"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                        <TranslateTransform Y="-8"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel>
                    <!-- Верхняя строка: точка статуса, заголовок и бейдж загрузки -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusBadgeForeground}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        
                        <TextBlock Grid.Column="1" Text="{Binding StatusHeadline}" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        
                        <!-- Бейдж загрузки если активна -->
                        <Border Grid.Column="2" Background="#1c3d5a" BorderBrush="#2b5f8c" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#52a9ff" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Загрузка" Foreground="#52a9ff" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Описание статуса (компактное) -->
                    <TextBlock Text="{Binding StatusMessageText}" Foreground="#9e9e9e" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Rectangle Fill="#282828" Height="1" Margin="0,0,0,8"/>

                    <!-- Компактная плашка с метриками: проверка и кэш -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Проверка -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Проверка" Foreground="#707070" FontSize="9" FontWeight="Medium"/>
                            <TextBlock Text="{Binding ShortLastCheckTime}" Foreground="#dcdcdc" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Fill="#2a2a2a" Width="1" Margin="8,2"/>

                        <!-- Кэш -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="Кэш обоев" Foreground="#707070" FontSize="9" FontWeight="Medium" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding CacheSizeString}" Foreground="#dcdcdc" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. СОДЕРЖИМОЕ СТРАНИЦ (TAB CONTROL) -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ВКЛАДКА 0: ГАЛЕРЕЯ (СЕТКА ОБОЕВ) -->
                <!-- ВКЛАДКА 0: ГАЛЕРЕЯ (СЕТКА ОБОЕВ) -->
                <TabItem>
                    <Grid Margin="10,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Сетка из плиток обоев с поддержкой бесконечного скролла natively -->
                        <ListBox x:Name="GalleryListBox" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding DisplayedImages}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.ScrollChanged="GalleryScrollViewer_ScrollChanged">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False" Style="{StaticResource SettingsScrollViewerStyle}">
                                        <ItemsPresenter x:Name="Presenter" Margin="0"/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Плитка обоев с анимацией масштабирования и подсветкой при наведении -->
                                    <Border Height="130" Margin="4" CornerRadius="6" ClipToBounds="True" Background="#1c1c1c" BorderThickness="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                        <Setter Property="BorderBrush" Value="#0078d4"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" 
                                                          Command="{Binding DataContext.DoubleClickedImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <!-- Изображение -->
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>

                                            <!-- Галочка примененных обоев (Несъемная, в левом верхнем углу) -->
                                            <Border Background="#2e7d32" CornerRadius="0,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="6,4"
                                                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z" Fill="#ffffff" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="АКТИВНО" Foreground="#ffffff" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Оверлей при наведении мыши -->
                                            <Grid x:Name="Overlay" Background="#b3000000" Opacity="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Краткое название обоев сверху -->
                                                <Border Grid.Row="0" VerticalAlignment="Top" Padding="8,8,8,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="#ffffff" FontSize="11" FontWeight="SemiBold" 
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                                </Border>

                                                <!-- Кнопки действий снизу -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                    <!-- Быстрое избранное (Звезда) -->
                                                    <Button Command="{Binding DataContext.ToggleFavoriteForItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="В избранное" Width="30" Height="26" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource IconStar}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="#cccccc"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Fill" Value="#0078d4"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Button>

                                                    <!-- Кнопка Инфо -->
                                                    <Button Command="{Binding DataContext.GoToImageDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="Информация" Width="30" Height="26" Style="{StaticResource HeaderButtonStyle}">
                                                        <Path Data="{StaticResource IconInfo}" Fill="#ffffff" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА 1: О ПРОГРАММЕ И НАСТРОЙКИ (ДРУГОЕ) -->
                <TabItem>
                    <Grid Margin="14,0,14,0">
                        <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,4,4,12">
                                <!-- 1. БЛОК "О ПРОГРАММЕ" (HERO CARD) -->
                                <Border Background="#1c1c1c" BorderBrush="#2b2b2b" BorderThickness="1" CornerRadius="12" Padding="16,20" Margin="0,0,0,12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- Логотип приложения -->
                                        <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" 
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"
                                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                        <!-- Название и бейдж версии -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="WallTray" Foreground="#ffffff" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="#252525" BorderBrush="#383838" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" Foreground="#52a9ff" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Подзаголовок -->
                                        <TextBlock Text="Автоматическая смена обоев Bing и Wallhaven" Foreground="#888888" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,14"/>

                                        <!-- Быстрые кнопки-ссылки (GitHub / Архив) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource FluentButtonStyle}" Height="28" Padding="12,0" Background="#252525" BorderBrush="#383838" BorderThickness="1" Margin="0,0,8,0"
                                                    Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/l1ratch/WallTray">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconGithub}" Fill="#ffffff" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="GitHub" Foreground="#ffffff" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource FluentButtonStyle}" Height="28" Padding="12,0" Background="#252525" BorderBrush="#383838" BorderThickness="1"
                                                    Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/v5tech/bing-wallpaper">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconInfo}" Fill="#888888" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Архив Bing" Foreground="#cccccc" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. ИНТЕРАКТИВНАЯ КАРТОЧКА "ПАРАМЕТРЫ ПРИЛОЖЕНИЯ" -->
                                <Button Command="{Binding GoToSettingsCommand}" Style="{StaticResource SettingsCardButtonStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка шестерёнки в круглом контейнере -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#282828" BorderBrush="#3a3a3a" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSettings}" Fill="#52a9ff" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Текстовый заголовок и описание -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Параметры приложения" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Автозагрузка, темы, каталоги, интервалы и источники" Foreground="#888888" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Стрелочка перехода -->
                                        <Path Grid.Column="2" Data="{StaticResource IconChevronRight}" Fill="#888888" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    </Grid>
                                </Button>

                                <!-- 3. РАЗДЕЛ ОБНОВЛЕНИЙ -->
                                <Border Background="#1c1c1c" BorderBrush="#2b2b2b" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Верхняя строка: заголовок и статус-бейдж -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Заголовок с иконкой -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconRefresh}" Fill="#52a9ff" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Обновления" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Бейдж статуса -->
                                            <Border Grid.Column="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#262626"/>
                                                        <Setter Property="BorderBrush" Value="#353535"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                <Setter Property="Background" Value="#174526"/>
                                                                <Setter Property="BorderBrush" Value="#257a3e"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#888888"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                        <Setter Property="Fill" Value="#7ee787"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Проверка"/>
                                                                <Setter Property="Foreground" Value="#aaaaaa"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                        <Setter Property="Text" Value="Есть обновление"/>
                                                                        <Setter Property="Foreground" Value="#7ee787"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Текст статуса -->
                                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="#b0b0b0" FontSize="11" Margin="0,0,0,12"/>

                                        <!-- Кнопки управления обновлениями -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Проверить сейчас -->
                                            <Button Grid.Column="0" Command="{Binding CheckUpdateCommand}" Height="34"
                                                    Style="{StaticResource FluentButtonStyle}" Background="#262626" BorderBrush="#383838" BorderThickness="1"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Fill="#ffffff" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Проверить обновления" Foreground="#ffffff" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Скачать (если доступно) -->
                                            <Button Grid.Column="1" Command="{Binding OpenReleaseUrlCommand}" Height="34" Padding="14,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconDownload}" Fill="#ffffff" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Скачать" Foreground="#ffffff" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА 3: ИЗБРАННОЕ -->
                <TabItem>
                    <Grid Margin="14,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Список избранного -->
                        <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,4,0,12">
                                <!-- Скелетон-заглушки при загрузке списка -->
                                <StackPanel Visibility="{Binding IsFavoritesLoading, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Скелетон карточка 1 -->
                                    <Border Background="#202020" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10" Opacity="0.8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="100" Height="62" CornerRadius="4" Background="#2a2a2a"/>
                                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                                <StackPanel VerticalAlignment="Top">
                                                    <Border Background="#2e2e2e" Height="14" Width="160" HorizontalAlignment="Left" CornerRadius="3" Margin="0,2,0,0"/>
                                                    <Border Background="#252525" Height="10" Width="200" HorizontalAlignment="Left" CornerRadius="2" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,6,0,0">
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727" Margin="0,0,6,0"/>
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727" Margin="0,0,6,0"/>
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Скелетон карточка 2 -->
                                    <Border Background="#202020" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10" Opacity="0.6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="100" Height="62" CornerRadius="4" Background="#2a2a2a"/>
                                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                                <StackPanel VerticalAlignment="Top">
                                                    <Border Background="#2e2e2e" Height="14" Width="130" HorizontalAlignment="Left" CornerRadius="3" Margin="0,2,0,0"/>
                                                    <Border Background="#252525" Height="10" Width="180" HorizontalAlignment="Left" CornerRadius="2" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,6,0,0">
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727" Margin="0,0,6,0"/>
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727" Margin="0,0,6,0"/>
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Скелетон карточка 3 -->
                                    <Border Background="#202020" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10" Opacity="0.4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="100" Height="62" CornerRadius="4" Background="#2a2a2a"/>
                                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                                <StackPanel VerticalAlignment="Top">
                                                    <Border Background="#2e2e2e" Height="14" Width="150" HorizontalAlignment="Left" CornerRadius="3" Margin="0,2,0,0"/>
                                                    <Border Background="#252525" Height="10" Width="140" HorizontalAlignment="Left" CornerRadius="2" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,6,0,0">
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727" Margin="0,0,6,0"/>
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727" Margin="0,0,6,0"/>
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#272727"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Текст при пустом списке избранного -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,120,0,0" IsHitTestVisible="False"
                                            Visibility="{Binding ShowFavoritesEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="★" Foreground="#444444" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Список избранного пуст" Foreground="#ffffff" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Добавляйте понравившиеся обои с помощью кнопки ★ на главном экране." Foreground="#888888" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" Width="280" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Элементы списка -->
                                <ItemsControl ItemsSource="{Binding FavoritesCollection}"
                                              Visibility="{Binding ShowFavoritesList, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Карточка избранного -->
                                            <Border Background="#202020" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Миниатюра (закругленная) с быстрым кэшированным декодером -->
                                                    <Border Grid.Column="0" Width="100" Height="62" CornerRadius="4" ClipToBounds="True" Background="#121212">
                                                        <Image Source="{Binding DisplayPath, Converter={StaticResource PathToThumbnailConverter}}" Stretch="UniformToFill"/>
                                                    </Border>

                                                    <!-- Текст и Кнопки управления справа -->
                                                    <Grid Grid.Column="1" Margin="12,0,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Заголовок и Копирайт -->
                                                        <StackPanel Grid.Row="0" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Title}" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Copyright}" Foreground="#888888" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Opacity="0.8"/>
                                                        </StackPanel>

                                                        <!-- Кнопки действий -->
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                                            <!-- Установить обоями -->
                                                            <Button Command="{Binding DataContext.ApplyFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" ToolTip="Установить обоями"
                                                                    Style="{StaticResource RoundIconButtonStyle}" Margin="0,0,6,0">
                                                                <Path Data="{StaticResource IconMonitor}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/>
                                                            </Button>

                                                            <!-- Открыть в папке -->
                                                            <Button Command="{Binding DataContext.OpenFavoriteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" ToolTip="Показать в папке"
                                                                    Style="{StaticResource RoundIconButtonStyle}" Margin="0,0,6,0">
                                                                <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/>
                                                            </Button>

                                                            <!-- Удалить из избранного -->
                                                            <Button Command="{Binding DataContext.RemoveFavoriteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" ToolTip="Удалить из избранного"
                                                                    Style="{StaticResource RoundIconButtonStyle}">
                                                                <Path Data="{StaticResource IconDelete}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА 4: ДЕТАЛИ ИЗОБРАЖЕНИЯ -->
                <TabItem>
                    <Grid Margin="14,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Содержимое деталей -->
                        <ScrollViewer Grid.Row="1" Style="{StaticResource SettingsScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,4,0,12">
                                <!-- Крупное превью с закруглениями -->
                                <Border Height="300" Background="#121212" CornerRadius="8" ClipToBounds="True" BorderBrush="#2d2d2d" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding SelectedDetailsImage.PreviewUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Темный градиент внизу для лучшей читаемости -->
                                        <Border VerticalAlignment="Bottom" Height="80" CornerRadius="0,0,8,8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                                    <GradientStop Color="#cc000000" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Индикатор "Установлено" на экране деталей -->
                                        <Border Background="#2e7d32" CornerRadius="0,4,0,4" Width="100" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding IsSelectedDetailsImageApplied, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="УСТАНОВЛЕНО" Foreground="#ffffff" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Информация об обоях -->
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{Binding SelectedDetailsImage.Title}" Foreground="#ffffff" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    
                                    <Border Background="#202020" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,14">
                                        <StackPanel>
                                            <!-- Описание / Авторское право -->
                                            <TextBlock Text="Авторское право:" Foreground="#888888" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedDetailsImage.Copyright}" Foreground="#e0e0e0" FontSize="12" TextWrapping="Wrap"/>
                                            
                                            <!-- Ссылка на Bing -->
                                            <TextBlock Text="Ссылка на источник:" Foreground="#888888" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                            <Button Style="{StaticResource FluentButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,0" Height="26" Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SelectedDetailsImage.CopyrightLink}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconInfo}" Fill="#ffffff" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Открыть страницу источника" Foreground="#ffffff" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Кнопки управления -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Применить обои -->
                                        <Button Grid.Column="0" Command="{Binding SetDetailsWallpaperCommand}" Content="Установить обоями"
                                                Style="{StaticResource AccentButtonStyle}" Height="36" FontSize="12"/>

                                        <!-- Избранное (Звезда) -->
                                        <Button Grid.Column="1" Command="{Binding ToggleDetailsFavoriteCommand}" Width="44" Height="36" Margin="8,0,0,0" Cursor="Hand" ToolTip="В избранное">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" CornerRadius="6" Background="#2d2d2d" BorderThickness="0">
                                                        <Path x:Name="starIcon" Data="{StaticResource IconStar}" Width="16" Height="16" Stretch="Uniform" Fill="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#3d3d3d"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelectedDetailsImageFavorite}" Value="True">
                                                            <Setter TargetName="starIcon" Property="Fill" Value="#0078d4"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 3. НИЖНЯЯ НАВИГАЦИЯ (встроенный нижний докер с верхней линией-разделителем) -->
            <Border Grid.Row="2" Margin="0,8,0,0" Background="#141414" BorderBrush="#252525" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9"
                    Visibility="{Binding IsBottomNavVisible, Converter={StaticResource BoolToVisibility}}" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="6"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid Margin="6,4,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="WallhavenNavColumn" Width="*">
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultipleSourcesEnabled}" Value="True">
                                            <Setter Property="Width" Value="*"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource DockNavButtonStyle}" Tag="{Binding IsNavBingActive}"
                            Command="{Binding SelectSourceAndGalleryCommand}" CommandParameter="Bing">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconSun}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding BingNavTabTitle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="10" FontWeight="Medium" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource DockNavButtonStyle}" Tag="{Binding IsNavWallhavenActive}"
                            Command="{Binding SelectSourceAndGalleryCommand}" CommandParameter="Wallhaven"
                            Visibility="{Binding IsMultipleSourcesEnabled, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconWave}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Wallhaven" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="10" FontWeight="Medium" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource DockNavButtonStyle}" Tag="{Binding IsNavFavoritesActive}" Command="{Binding GoToFavoritesCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconStar}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Избранное" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="10" FontWeight="Medium" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource DockNavButtonStyle}" Tag="{Binding IsNavMoreActive}" Command="{Binding GoToAboutCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconMore}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Другое" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="10" FontWeight="Medium" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
