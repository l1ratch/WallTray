<Window x:Class="BingWallTray.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BingWallTray.App"
        xmlns:utils="clr-namespace:BingWallTray.App.Utils"
        mc:Ignorable="d"
        Title="WallTray" Height="680" Width="460" Icon="pack://application:,,,/Assets/logo.png"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Activated="Window_Activated">
    
    <Window.Resources>
        <!-- Конвертеры -->
        <utils:PathToThumbnailConverter x:Key="PathToThumbnailConverter"/>
