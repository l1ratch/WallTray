<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    
    <!-- Имя сборки и иконка -->
    <AssemblyName>WallTray</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    
    <!-- Метаданные сборки и свойства исполняемого файла -->
    <Product>WallTray</Product>
    <AssemblyTitle>WallTray</AssemblyTitle>
    <Authors>l1ratch</Authors>
    <Company>l1ratch</Company>
    <Description>WallTray — Автоматическая установка и каталогизация обоев Bing Image of the Day и Wallhaven для Windows</Description>
    <Copyright>© 2026 l1ratch. All rights reserved.</Copyright>
    <RepositoryUrl>https://github.com/l1ratch/WallTray</RepositoryUrl>
    <PackageProjectUrl>https://github.com/l1ratch/WallTray</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <!-- Версионирование CalVer (YY.M.Patch) -->
    <Version>26.8.2</Version>
    <AssemblyVersion>26.8.2.0</AssemblyVersion>
    <FileVersion>26.8.2.0</FileVersion>
    <InformationalVersion>26.8.2</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\app.ico" />
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
