<Window x:Class="BingWallTray.App.Views.ContextMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BingWallTray.App.Views"
        mc:Ignorable="d"
        Title="Menu" Width="200" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    
    <Window.Resources>
        <!-- Стиль для кнопок меню -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2d2d2d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3d3d3d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для переключателей в меню -->
        <Style x:Key="MenuToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Галочка включенного состояния -->
                                <TextBlock x:Name="checkMark" Grid.Column="0" Text="✓" Foreground="#0078d4" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
                                
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2d2d2d"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Тень и граница меню -->
    <Border Margin="6" Background="#1c1c1c" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.4" ShadowDepth="2" Direction="270"/>
        </Border.Effect>
        
        <StackPanel Margin="2,4">
            
            <!-- Шапка меню -->
            <TextBlock Text="BingWallTray" Foreground="#5a5a5a" FontSize="10" FontWeight="SemiBold" Margin="12,4,0,4"/>
            <Border Height="1" Background="#2d2d2d" Margin="6,2"/>

            <!-- Переключатели режимов -->
            <ToggleButton Style="{StaticResource MenuToggleButtonStyle}" IsChecked="{Binding AutoChangeEnabled}">
                <TextBlock Text="Автосмена обоев" FontSize="12"/>
            </ToggleButton>
            
            <ToggleButton Style="{StaticResource MenuToggleButtonStyle}" IsChecked="{Binding Paused}">
                <TextBlock Text="Пауза проверок" FontSize="12"/>
            </ToggleButton>
            
            <ToggleButton Style="{StaticResource MenuToggleButtonStyle}" IsChecked="{Binding Locked}">
                <TextBlock Text="Фиксация обоев" FontSize="12"/>
            </ToggleButton>

            <Border Height="1" Background="#2d2d2d" Margin="6,2"/>

            <!-- Действия -->
            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding OpenFolderCommand}" Click="MenuItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Открыть папку обоев" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ExitCommand}" Click="MenuItem_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="❌" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#ff5555"/>
                    <TextBlock Text="Выход из программы" FontSize="12" VerticalAlignment="Center" Foreground="#ff5555"/>
                </StackPanel>
            </Button>
            
        </StackPanel>
    </Border>
</Window>
