<Window x:Class="BingWallTray.App.Views.ContextMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BingWallTray.App.Views"
        mc:Ignorable="d"
        Title="WallTray Menu" Width="220" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    
    <Window.Resources>
        <!-- Векторная геометрия иконок -->
        <Geometry x:Key="IconApp">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4Z</Geometry>
        <Geometry x:Key="IconGallery">M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z</Geometry>
        <Geometry x:Key="IconNext">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</Geometry>
        <Geometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="IconSettings">M19.14,12.94C19.18,12.63 19.2,12.32 19.2,12C19.2,11.68 19.18,11.37 19.14,11.06L21.14,9.5C21.32,9.36 21.37,9.1 21.26,8.9L19.36,5.6C19.24,5.4 19,5.32 18.78,5.41L16.42,6.36C15.93,5.97 15.39,5.66 14.8,5.42L14.44,2.9C14.4,2.68 14.22,2.5 14,2.5H10.18C9.96,2.5 9.78,2.68 9.74,2.9L9.38,5.42C8.79,5.66 8.25,5.97 7.76,6.36L5.4,5.41C5.18,5.32 4.94,5.4 4.82,5.6L2.92,8.9C2.81,9.1 2.86,9.36 3.04,9.5L5.04,11.06C5,11.37 4.98,11.68 4.98,12C4.98,12.32 5,12.63 5.04,12.94L3.04,14.5C2.86,14.64 2.81,14.9 2.92,15.1L4.82,18.4C4.94,18.6 5.18,18.68 5.4,18.59L7.76,17.64C8.25,18.03 8.79,18.34 9.38,18.58L9.74,21.1C9.78,21.32 9.96,21.5 10.18,21.5H14C14.22,21.5 14.4,21.32 14.44,21.1L14.8,18.58C15.39,18.34 15.93,18.03 16.42,17.64L18.78,18.59C19,18.68 19.24,18.6 19.36,18.4L21.26,15.1C21.37,14.9 21.32,14.64 21.14,14.5L19.14,12.94ZM12,15.6C10,15.6 8.4,14 8.4,12C8.4,10 10,8.4 12,8.4C14,8.4 15.6,10 15.6,12C15.6,14 14,15.6 12,15.6Z</Geometry>
        <Geometry x:Key="IconPower">M16.56,5.44L15.15,6.85C16.89,8.37 18,10.56 18,13A6,6 0 0,1 12,19A6,6 0 0,1 6,13C6,10.56 7.11,8.37 8.85,6.85L7.44,5.44C5.32,7.31 4,10 4,13A8,8 0 0,0 12,21A8,8 0 0,0 20,13C20,10 18.68,7.31 16.56,5.44M13,3H11V13H13V3Z</Geometry>

        <!-- Стиль для стандартных кнопок контекстного меню -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f0f0f0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2c2c2c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки Выхода с деликатным красным акцентом при наведении -->
        <Style x:Key="MenuExitButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3a1c1c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4d2222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для переключателей режимов с галочкой -->
        <Style x:Key="MenuToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f0f0f0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Галочка включенного состояния -->
                                <Path x:Name="checkMark" Grid.Column="0" Data="{StaticResource IconCheck}" Fill="#0078d4" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2c2c2c"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Тень и граница меню -->
    <Border Margin="8" Background="#1c1c1e" BorderBrush="#2e2e32" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.55" ShadowDepth="4" Direction="270"/>
        </Border.Effect>
        
        <StackPanel Margin="3,6">
            
            <!-- Шапка меню -->
            <Grid Margin="10,4,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconApp}" Fill="#0078d4" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="WallTray" Foreground="#ffffff" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding AppVersion, StringFormat='v{0}'}" Foreground="#666666" FontSize="10" VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1" Background="#2b2b2f" Margin="6,2,6,4"/>

            <!-- 1. Главные действия с окном и обоями -->
            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding OpenMainWindowCommand}" Click="MenuItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconGallery}" Fill="#0078d4" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Открыть WallTray" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding CheckNowCommand}" Click="MenuItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconNext}" Fill="#aaaaaa" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Сменить обои сейчас" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Button>

            <Border Height="1" Background="#2b2b2f" Margin="6,3"/>

            <!-- 2. Быстрые переключатели автоматизации -->
            <ToggleButton Style="{StaticResource MenuToggleButtonStyle}" IsChecked="{Binding AutoChangeEnabled}">
                <TextBlock Text="Автосмена обоев" FontSize="12"/>
            </ToggleButton>
            
            <ToggleButton Style="{StaticResource MenuToggleButtonStyle}" IsChecked="{Binding Paused}">
                <TextBlock Text="Пауза проверок" FontSize="12"/>
            </ToggleButton>

            <Border Height="1" Background="#2b2b2f" Margin="6,3"/>

            <!-- 3. Системные разделы и настройки -->
            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding OpenSettingsWindowCommand}" Click="MenuItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSettings}" Fill="#aaaaaa" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Параметры..." FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding OpenFolderCommand}" Click="MenuItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconFolder}" Fill="#aaaaaa" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Папка с обоями" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Button>

            <Border Height="1" Background="#2b2b2f" Margin="6,3"/>

            <!-- 4. Завершение работы -->
            <Button Style="{StaticResource MenuExitButtonStyle}" Command="{Binding ExitCommand}" Click="MenuItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconPower}" Fill="#ff6b6b" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Выход" FontSize="12" Foreground="#ff6b6b" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Button>
            
        </StackPanel>
    </Border>
</Window>
