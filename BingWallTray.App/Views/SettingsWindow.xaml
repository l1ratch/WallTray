                            <TextBlock Text="КЛЮЧЕВЫЕ ВОЗМОЖНОСТИ" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="• Ежедневные обои Bing в сверхвысоком разрешении 4K UHD" Foreground="#cccccc" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="• Интеграция каталога Wallhaven.cc с фильтрами тегов и категорий" Foreground="#cccccc" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="• Автосмена по расписанию и при запуске системы" Foreground="#cccccc" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="• Быстрое избранное с мгновенной установкой в один клик" Foreground="#cccccc" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="• Локальная изоляция кэша в AppData без конфликтов с OneDrive" Foreground="#cccccc" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Ссылки и репозиторий -->
                            <TextBlock Text="РЕСУРСЫ И СООБЩЕСТВО" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Официальный сайт WallTray" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                    <TextBlock Text="Новости проекта, документация, скриншоты и последние сборки" Foreground="#888888" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                    <Button Content="Перейти на сайт проекта" Style="{StaticResource LinkButton}" Command="{Binding OpenUrlCommand}" CommandParameter="https://project.l1ratch.ru/WallTray/" HorizontalAlignment="Left"/>
