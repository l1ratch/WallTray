                                                                    <Condition Binding="{Binding IsUpdateAvailable}" Value="True"/>
                                                                    <Condition Binding="{Binding IsUpdateDownloaded}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

