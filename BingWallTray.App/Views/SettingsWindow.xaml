                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 8. СТРАНИЦА: ЦЕНТР ОБНОВЛЕНИЙ -->
                        <StackPanel Visibility="{Binding IsPageUpdates, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Обновления" Style="{StaticResource PageTitle}"/>
