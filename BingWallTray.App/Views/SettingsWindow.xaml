                                        </Grid>
                                        <ProgressBar Style="{StaticResource UpdateProgressBar}" Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

