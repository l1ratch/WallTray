                                        <TextBlock Text="{Binding OSVersion}" Foreground="#ffffff" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Логирование и параметры файлов -->
                            <TextBlock Text="ПАРАМЕТРЫ ЛОГИРОВАНИЯ" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Запись событий в файл журнала" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Фиксировать работу приложения для выявления возможных ошибок" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LoggingEnabled}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Уровень логирования" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Детальность сохраняемых сообщений" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="120" SelectedValuePath="Content" SelectedValue="{Binding LogLevel}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Debug"/>
                                        <ComboBoxItem Content="Info"/>
                                        <ComboBoxItem Content="Warning"/>
                                        <ComboBoxItem Content="Error"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="Открыть папку" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogsCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Раскрывающийся хайд (аккордеон) журнала событий с идеальными внутренними отступами -->
                            <TextBlock Text="КОНСОЛЬ ЖУРНАЛА" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}" Padding="0" ClipToBounds="True">
                                <StackPanel>
                                    <!-- Заголовок раскрывающегося хайда -->
                                    <Button Command="{Binding ToggleLogConsoleCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="16,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Data="{StaticResource IconTerminal}" Fill="#0078d4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <TextBlock Text="Журнал последних событий (консоль)" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                                            <TextBlock Text="Нажмите, чтобы просмотреть или скрыть последние 35 строк лога" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <!-- Индикатор стрелочка -->
                                                        <TextBlock Grid.Column="2" Foreground="#888888" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="▼ Показать"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLogConsoleExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="▲ Скрыть"/>
                                                                            <Setter Property="Foreground" Value="#0078d4"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Раскрывающееся тело консоли -->
                                    <Border Background="#0d0d0d" BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="16"
                                            Visibility="{Binding IsLogConsoleExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="Консоль событий (последние 35 строк):" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
