                                                        <Border Grid.Column="2" Background="#1c2d42" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ResolutionString}" Foreground="#38a6ff" FontSize="11.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Версия ОС -->
                                    <Grid Margin="0,6,0,0">
