        <!-- Векторные стили для кнопок окна (Свернуть, Развернуть, Закрыть) -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#222222"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#c42b1c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#a82315"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Сверхтонкий аккуратный скроллбар в стиле iOS / macOS / Fluent (Ширина 5px, без системных границ) -->
        <Style x:Key="SlimScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="rectangle" Background="#ffffff" Opacity="0.22" CornerRadius="2.5" Margin="0,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="rectangle" Property="Background" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="5">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Width="5">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                            <!-- Тонкий плавающий скроллбар на правом краю -->
                            <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SlimScrollBarStyle}" HorizontalAlignment="Right" VerticalAlignment="Stretch" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок группы сайдбара -->
        <Style x:Key="SidebarGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="12,16,0,6"/>
        </Style>

        <!-- Навигационные кнопки сайдбара с явным акцентом активного состояния -->
        <Style x:Key="SettingsNavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a0a0a0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="2,1.5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Левая вертикальная полоска-индикатор -->
                                <Border x:Name="bar" Grid.Column="0" Background="Transparent" CornerRadius="1.5" Margin="0,3" HorizontalAlignment="Left" Width="3"/>
                                <!-- Иконка и контент -->
                                <ContentPresenter Grid.Column="1" Grid.ColumnSpan="2" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#1c1c1c"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <!-- Активное состояние кнопки -->
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#1d2838"/>
                                <Setter TargetName="root" Property="BorderBrush" Value="#254266"/>
                                <Setter TargetName="bar" Property="Background" Value="#0078d4"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подпункты навигации (вложенные кнопки источников) -->
        <Style x:Key="SettingsNavSubItem" TargetType="Button" BasedOn="{StaticResource SettingsNavItem}">
            <Setter Property="Padding" Value="24,7,12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888888"/>
        </Style>

        <!-- Типографика и карточки -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,20"/>
        </Style>

        <Style x:Key="SectionGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0078d4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Единая карточка настроек на всю ширину блока -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#1b1b1b"/>
            <Setter Property="BorderBrush" Value="#282828"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Кастомный темный Windows 11 Fluent CheckBox со стильной векторной галочкой -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Квадратик чекбокса -->
                            <Border x:Name="box" Grid.Column="0" Width="18" Height="18" 
                                    Background="#1a1a1a" BorderBrush="#444444" BorderThickness="1.2" 
                                    CornerRadius="4" VerticalAlignment="Center">
                                <!-- Векторная галочка SVG -->
                                <Path x:Name="checkMark" Data="M3,8.5 L6.5,12 L13.5,4.5" 
                                      Stroke="#ffffff" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>
                            
                            <!-- Контент чекбокса -->
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#0078d4"/>
                                <Setter TargetName="box" Property="Background" Value="#242424"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#0078d4"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#0086ea"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Fluent Toggle Switch (для переключателей Да/Нет) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22">
                            <Border x:Name="track" Background="#333333" BorderBrush="#444444" BorderThickness="1" CornerRadius="11"/>
                            <Border x:Name="thumb" Width="14" Height="14" Background="#cccccc" CornerRadius="7" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#0078d4"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#0078d4"/>
                                <Setter TargetName="thumb" Property="Background" Value="#ffffff"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Кнопки -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#303030"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1e1e1e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="BorderBrush" Value="#0086ea"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1084d8"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2896e8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#006cc1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#107c41"/>
            <Setter Property="BorderBrush" Value="#158f4b"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#148d4a"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#1ba357"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0c6635"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- Кнопка-чип для быстрого выбора тегов -->
        <Style x:Key="TagChipButton" TargetType="Button">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#bbbbbb"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2b3b4f"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078d4"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стильный прогрессбар обновления -->
        <Style x:Key="UpdateProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#0078d4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#222222" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" Background="#222222"/>
                                <Border x:Name="PART_Indicator" Background="#0078d4" CornerRadius="3" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поля ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#ffffff"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4a4a4a"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тёмный Fluent ComboBox с тёмным выпадающим списком (без белых засветов) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1d2d42"/>
                                <Setter Property="Foreground" Value="#38a6ff"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton для ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="#1c1c1c" BorderBrush="#383838" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <!-- Стрелочка шеврон -->
                    <Path Grid.Column="1" Data="M1,1 L4.5,4.5 L8,1" Stroke="#888888" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#555555"/>
                    <Setter TargetName="templateRoot" Property="Background" Value="#242424"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#0078d4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="#1c1c1c"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="Left" Margin="10,0,32,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" MaxHeight="220" MinWidth="{Binding ActualWidth, ElementName=templateRoot}" Padding="2,4" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Opacity="0.6" ShadowDepth="4" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Внешний матовый контейнер окна с закруглениями и тенью -->
    <Border Margin="8" Background="#141414" BorderBrush="#2b2b2b" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Opacity="0.65" ShadowDepth="6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА ОКНА (TitleBar с ровными векторными кнопками управления) -->
            <Border Grid.Row="0" Background="#111111" BorderBrush="#222222" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,8,0">
                    <!-- Заголовок слева -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        <TextBlock Text="Параметры" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="• WallTray" Foreground="#666666" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Ровные векторные кнопки управления окном справа -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Свернуть -->
                        <Button Style="{StaticResource WindowControlButtonStyle}" ToolTip="Свернуть" Click="MinimizeButton_Click">
                            <Path Data="M0,0 H10" Stroke="#cccccc" StrokeThickness="1.2" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Развернуть / Восстановить -->
                        <Button Style="{StaticResource WindowControlButtonStyle}" ToolTip="Развернуть" Click="MaximizeButton_Click">
                            <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="#cccccc" StrokeThickness="1.2" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <!-- Закрыть -->
                        <Button Style="{StaticResource WindowCloseControlButtonStyle}" ToolTip="Закрыть" Click="CloseButton_Click">
                            <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#cccccc" StrokeThickness="1.2" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. ОСНОВНАЯ ОБЛАСТЬ: САЙДБАР С ГРУППАМИ + КОНТЕНТ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВЫЙ САЙДБАР (Группы НАСТРОЙКИ и О ПРОГРАММЕ с подстраницами источников) -->
                <Border Grid.Column="0" Background="#111111" BorderBrush="#222222" BorderThickness="0,0,1,0" CornerRadius="0,0,0,11">
                    <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,8,6,12">
                            <!-- ГРУППА 1: НАСТРОЙКИ -->
                            <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource SidebarGroupHeader}"/>

                            <!-- 0. Общие -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="0" Tag="{Binding IsPageGeneral}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGeneral}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Общие" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 1. Источники обоев (Главная обзора) -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="1" Tag="{Binding IsPageSources}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSources}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Источники обоев" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Подпункт: Bing -->
                            <Button Style="{StaticResource SettingsNavSubItem}" Command="{Binding SelectPageCommand}" CommandParameter="2" Tag="{Binding IsPageBing}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBing}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Bing Image" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Подпункт: Wallhaven -->
                            <Button Style="{StaticResource SettingsNavSubItem}" Command="{Binding SelectPageCommand}" CommandParameter="3" Tag="{Binding IsPageWallhaven}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconWallhaven}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Wallhaven" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. Автосмена -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="4" Tag="{Binding IsPageAutoChange}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAutoChange}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Автосмена" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Хранилище и кэш -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="5" Tag="{Binding IsPageStorage}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconStorage}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Хранилище и кэш" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Диагностика и логи -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="6" Tag="{Binding IsPageDiagnostics}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDiagnostics}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Диагностика и логи" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- ГРУППА 2: О ПРОГРАММЕ -->
                            <TextBlock Text="О ПРИЛОЖЕНИИ" Style="{StaticResource SidebarGroupHeader}" Margin="12,18,0,6"/>

                            <!-- 7. О программе -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="7" Tag="{Binding IsPageAbout}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAbout}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="О программе" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 8. Обновления -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="8" Tag="{Binding IsPageUpdates}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconUpdates}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Обновления" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 9. Лицензии -->
                            <Button Style="{StaticResource SettingsNavItem}" Command="{Binding SelectPageCommand}" CommandParameter="9" Tag="{Binding IsPageLicenses}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLicenses}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Лицензии и права" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ПРАВАЯ ОБЛАСТЬ КОНТЕНТА: Растянутая на всю ширину с защитой от наложений -->
                <ScrollViewer Grid.Column="1" Style="{StaticResource SettingsScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,24,36,28">
                    <Grid HorizontalAlignment="Stretch" MaxWidth="820">

                        <!-- 0. СТРАНИЦА: ОБЩИЕ -->
                        <StackPanel Visibility="{Binding IsPageGeneral, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Общие параметры" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Стиль размещения обоев на рабочем столе, автозапуск и уведомления" Style="{StaticResource PageSubtitle}"/>

                            <!-- Стиль обоев -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Стиль обоев" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Способ масштабирования и размещения изображения на экране" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="170" SelectedValuePath="Tag" SelectedValue="{Binding WallpaperStyle}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Заполнить (Fill)" Tag="Fill"/>
                                        <ComboBoxItem Content="По размеру (Fit)" Tag="Fit"/>
                                        <ComboBoxItem Content="Растянуть (Stretch)" Tag="Stretch"/>
                                        <ComboBoxItem Content="Замостить (Tile)" Tag="Tile"/>
                                        <ComboBoxItem Content="По центру (Center)" Tag="Center"/>
                                        <ComboBoxItem Content="Расширить (Span)" Tag="Span"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Интервал проверки -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Интервал проверки новых обоев (часы)" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Как часто приложение проверяет появление новых изображений в сети" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="80" Text="{Binding CheckIntervalHours, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="ЗАПУСК И СИСТЕМА" Style="{StaticResource SectionGroupHeader}"/>

                            <!-- Автозапуск -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Автозапуск при входе в систему" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Автоматически запускать WallTray при старте Windows" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsStartupEnabled}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Запуск свернуто -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Запускать свёрнутым в трей" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Не открывать главное окно при автоматическом или ручном старте" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimizedToTray}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Уведомления -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Системные уведомления" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Показывать всплывающие оповещения о смене обоев и событиях" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowNotifications}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 1. СТРАНИЦА: ОБЗОР ИСТОЧНИКОВ ОБОЕВ -->
                        <StackPanel Visibility="{Binding IsPageSources, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Источники обоев" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Выберите источник изображений для перехода к его детальной настройке" Style="{StaticResource PageSubtitle}"/>

                            <!-- Карточка-ссылка Bing -->
                            <Border Style="{StaticResource SettingsCard}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#1c2c3e" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconBing}" Fill="#0078d4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Bing Image of the Day" FontSize="14" FontWeight="SemiBold" Foreground="#ffffff"/>
                                            <Border Background="#1b382b" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Активен" Foreground="#2ecc71" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Официальные ежедневные обои Microsoft в разрешении до 4K UHD с архивом за предыдущие дни." Foreground="#888888" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Настроить Bing →" Style="{StaticResource SecondaryButton}" Command="{Binding SelectPageCommand}" CommandParameter="2" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Карточка-ссылка Wallhaven -->
                            <Border Style="{StaticResource SettingsCard}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#2e2538" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconWallhaven}" Fill="#a855f7" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Каталог Wallhaven.cc" FontSize="14" FontWeight="SemiBold" Foreground="#ffffff"/>
                                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#252525"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EnableWallhaven}" Value="True">
                                                                <Setter Property="Background" Value="#1b382b"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Выключен"/>
                                                            <Setter Property="Foreground" Value="#888888"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EnableWallhaven}" Value="True">
                                                                    <Setter Property="Text" Value="Включен"/>
                                                                    <Setter Property="Foreground" Value="#2ecc71"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Крупнейший каталог пользовательских обоев с гибким поиском по тегам, категориям и форматам экрана." Foreground="#888888" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Настроить Wallhaven →" Style="{StaticResource SecondaryButton}" Command="{Binding SelectPageCommand}" CommandParameter="3" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 2. СТРАНИЦА: НАСТРОЙКИ BING -->
                        <StackPanel Visibility="{Binding IsPageBing, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Источник: Bing Image of the Day" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Параметры региона, ультравысокого разрешения UHD и загрузки архива" Style="{StaticResource PageSubtitle}"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Регион контента (Market)" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Региональный код для получения локализованных ежедневных изображений Bing" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="170" SelectedValuePath="Tag" SelectedValue="{Binding Market}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="ru-RU (Россия)" Tag="ru-RU"/>
                                        <ComboBoxItem Content="en-US (США)" Tag="en-US"/>
                                        <ComboBoxItem Content="de-DE (Германия)" Tag="de-DE"/>
                                        <ComboBoxItem Content="fr-FR (Франция)" Tag="fr-FR"/>
                                        <ComboBoxItem Content="ja-JP (Япония)" Tag="ja-JP"/>
                                        <ComboBoxItem Content="zh-CN (Китай)" Tag="zh-CN"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="UHD Разрешение (4K / 3840×2160)" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Загружать изображения в максимально доступном разрешении 4K UHD" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding UseUhd}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Исторический архив обоев Bing" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Отображать в галерее и автосмене коллекцию обоев Bing за прошлые дни, недели и месяцы из открытого онлайн-архива GitHub" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableHistoricalArchive}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Автопроверка новых Bing-обоев" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Периодически проверять появление сегодняшних обоев в фоне" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoCheckBingEnabled}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 3. СТРАНИЦА: НАСТРОЙКИ WALLHAVEN -->
                        <StackPanel Visibility="{Binding IsPageWallhaven, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Источник: Wallhaven.cc" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Тонкая настройка каталога, тематических категорий, тегов и поддерживаемых экранов" Style="{StaticResource PageSubtitle}"/>

                            <!-- Активация источника -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Включить источник Wallhaven" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Отображать вкладку Wallhaven в нижней навигации и главном окне" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableWallhaven}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Удобные визуальные категории (Кастомные тёмные Fluent CheckBox) -->
                            <TextBlock Text="КАТЕГОРИИ КОНТЕНТА" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Тематические категории" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                    <TextBlock Text="Отметьте группы изображений, которые должны присутствовать в каталоге" Foreground="#888888" FontSize="11" Margin="0,3,0,12" TextWrapping="Wrap"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- General -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding WallhavenCatGeneral}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Margin="2,0,0,0">
                                                <TextBlock Text="General" Foreground="#ffffff" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="Природа, пейзажи, город" Foreground="#888888" FontSize="10"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <!-- Anime -->
                                        <CheckBox Grid.Column="1" IsChecked="{Binding WallhavenCatAnime}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Margin="2,0,0,0">
                                                <TextBlock Text="Anime" Foreground="#ffffff" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="Аниме, манга, арт" Foreground="#888888" FontSize="10"/>
                                            </StackPanel>
                                        </CheckBox>

                                        <!-- People -->
                                        <CheckBox Grid.Column="2" IsChecked="{Binding WallhavenCatPeople}" VerticalAlignment="Center">
                                            <StackPanel Margin="2,0,0,0">
                                                <TextBlock Text="People" Foreground="#ffffff" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="Люди, фотомодели" Foreground="#888888" FontSize="10"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Поисковый запрос и быстрые теги -->
                            <TextBlock Text="ПОИСКОВЫЙ ЗАПРОС И ТЕГИ" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Ключевые слова для поиска" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                    <TextBlock Text="Введите теги для фильтрации или выберите из популярных ниже" Foreground="#888888" FontSize="11" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding WallhavenQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                    <!-- Быстрые чипы-теги -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource TagChipButton}" Content="🌱 nature" Command="{Binding SetWallhavenQueryCommand}" CommandParameter="nature"/>
                                        <Button Style="{StaticResource TagChipButton}" Content="🌌 space" Command="{Binding SetWallhavenQueryCommand}" CommandParameter="space"/>
                                        <Button Style="{StaticResource TagChipButton}" Content="🏙️ cyberpunk" Command="{Binding SetWallhavenQueryCommand}" CommandParameter="cyberpunk"/>
                                        <Button Style="{StaticResource TagChipButton}" Content="🏔️ landscape" Command="{Binding SetWallhavenQueryCommand}" CommandParameter="landscape"/>
                                        <Button Style="{StaticResource TagChipButton}" Content="🎨 minimalism" Command="{Binding SetWallhavenQueryCommand}" CommandParameter="minimalism"/>
                                        <Button Style="{StaticResource TagChipButton}" Content="🏎️ cars" Command="{Binding SetWallhavenQueryCommand}" CommandParameter="cars"/>
                                        <Button Style="{StaticResource TagChipButton}" Content="🐉 fantasy" Command="{Binding SetWallhavenQueryCommand}" CommandParameter="fantasy"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Разрешения экранов -->
                            <TextBlock Text="ФИЛЬТР РАЗРЕШЕНИЙ" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Поддерживаемые разрешения" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                            <TextBlock Text="Загружать только обои, соответствующие выбранным форматам мониторов" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Content="🎯 Автоопределение моих экранов" Style="{StaticResource SecondaryButton}" Command="{Binding AutoDetectResolutionCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="28" Padding="10,2" FontSize="11"/>
                                    </Grid>

                                    <WrapPanel Margin="0,4,0,10">
                                        <CheckBox Content="Full HD (1920×1080)" IsChecked="{Binding WallhavenRes1080p}" Margin="0,0,18,8"/>
                                        <CheckBox Content="2K QHD (2560×1440)" IsChecked="{Binding WallhavenRes1440p}" Margin="0,0,18,8"/>
                                        <CheckBox Content="4K UHD (3840×2160)" IsChecked="{Binding WallhavenRes4K}" Margin="0,0,18,8"/>
                                        <CheckBox Content="UltraWide (3440×1440)" IsChecked="{Binding WallhavenResUltrawide}" Margin="0,0,18,8"/>
                                    </WrapPanel>

                                    <TextBlock Text="Пользовательская строка разрешений:" Foreground="#666666" FontSize="10.5" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding WallhavenResolutions, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 4. СТРАНИЦА: АВТОСМЕНА -->
                        <StackPanel Visibility="{Binding IsPageAutoChange, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Автосмена обоев" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Настройка автоматической смены изображений по таймеру или при запуске" Style="{StaticResource PageSubtitle}"/>

                            <!-- Включение автосмены -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Активировать автосмену" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Автоматически устанавливать новые обои по расписанию" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoChangeEnabled}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Блок параметров автосмены (активен, если включена автосмена) -->
                            <StackPanel IsEnabled="{Binding IsAutoChangeOptionsEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1.0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoChangeOptionsEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Источник обоев -->
                                <TextBlock Text="ИСТОЧНИК ИЗОБРАЖЕНИЙ" Style="{StaticResource SectionGroupHeader}"/>

                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                            <TextBlock Text="Коллекция для автосмены" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                            <TextBlock Text="Откуда выбирать обои для автоматической установки" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="180" SelectedValuePath="Tag" SelectedValue="{Binding AutoChangeSource}" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Сегодняшние Bing" Tag="TodayBing"/>
                                            <ComboBoxItem Content="Случайные Bing" Tag="RandomBing"/>
                                            <ComboBoxItem Content="Wallhaven" Tag="Wallhaven" Visibility="{Binding IsWallhavenAutoChangeAvailable, Converter={StaticResource BoolToVisibility}}"/>
                                            <ComboBoxItem Content="Избранное" Tag="Favorites"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Пояснение для режима "Сегодняшние Bing" -->
                                <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsTodayBingSelected, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconInfo}" Fill="#0078d4" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,14,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Режим «Обои дня Bing»" FontWeight="Medium" Foreground="#ffffff" FontSize="12.5"/>
                                            <TextBlock Text="Новые обои Microsoft Bing выходят один раз в сутки. Приложение проверяет публикацию свежего изображения и обновляет рабочий стол при смене дня или при запуске Windows." Foreground="#888888" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Параметры периодической автосмены (Случайные Bing, Wallhaven, Избранное) -->
                                <StackPanel Visibility="{Binding IsPeriodicSourceSelected, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Условие запуска -->
                                    <TextBlock Text="РАСПИСАНИЕ И ТРИГГЕРЫ" Style="{StaticResource SectionGroupHeader}"/>

                                    <Border Style="{StaticResource SettingsCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="Событие для смены обоев" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                                <TextBlock Text="Когда запускать смену: периодически по интервалу, при запуске программы или оба варианта" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="180" SelectedValuePath="Tag" SelectedValue="{Binding AutoChangeTrigger}" VerticalAlignment="Center">
                                                <ComboBoxItem Content="По интервалу" Tag="Interval"/>
                                                <ComboBoxItem Content="При запуске" Tag="Startup"/>
                                                <ComboBoxItem Content="Интервал и запуск" Tag="Both"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Интервал автосмены -->
                                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsIntervalTriggerVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Интервал автосмены" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                                    <TextBlock Text="Периодичность смены обоев в фоновом режиме" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" Width="140" SelectedValuePath="Content" SelectedValue="{Binding SelectedIntervalPreset}" VerticalAlignment="Center">
                                                    <ComboBoxItem Content="15m"/>
                                                    <ComboBoxItem Content="30m"/>
                                                    <ComboBoxItem Content="1h"/>
                                                    <ComboBoxItem Content="2h"/>
                                                    <ComboBoxItem Content="6h"/>
                                                    <ComboBoxItem Content="12h"/>
                                                    <ComboBoxItem Content="24h"/>
                                                    <ComboBoxItem Content="Custom"/>
                                                </ComboBox>
                                            </Grid>

                                            <!-- Пользовательский интервал -->
                                            <Grid Margin="0,12,0,0" Visibility="{Binding IsCustomIntervalVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Собственное значение (например: 45m, 3h):" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"/>
                                                <TextBox Grid.Column="1" Width="140" Text="{Binding CustomIntervalString, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 5. СТРАНИЦА: ХРАНИЛИЩЕ И КЭШ -->
                        <StackPanel Visibility="{Binding IsPageStorage, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Хранилище и кэш" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Расположение загруженных обоев, управление кэшем и автоочистка старых файлов" Style="{StaticResource PageSubtitle}"/>

                            <!-- Папка сохранения -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Папка сохранения обоев" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                    <TextBlock Text="Локальная папка для хранения кэшированных и применённых обоев" Foreground="#888888" FontSize="11" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DownloadFolder}" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource SecondaryButton}" Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0"/>
                                        <Button Grid.Column="2" Content="Открыть папку" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDownloadFolderCommand}" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Кэш и очистка -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Размер локального кэша" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="{Binding CacheSizeString}" Foreground="#0078d4" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Очистить кэш" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCacheCommand}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="АВТОМАТИЧЕСКОЕ ОБСЛУЖИВАНИЕ" Style="{StaticResource SectionGroupHeader}"/>

                            <!-- Удалять старые изображения -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Автоочистка старых изображений" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Автоматически удалять неиспользуемые обои (избранные обои никогда не удаляются)" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding DeleteOldImages}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Хранить последние N изображений -->
                            <Border Style="{StaticResource SettingsCard}" Visibility="{Binding DeleteOldImages, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Text="Лимит хранения (последние N файлов)" FontWeight="Medium" Foreground="#ffffff" FontSize="13"/>
                                        <TextBlock Text="Количество свежих изображений, которые будут гарантированно сохранены" Foreground="#888888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="80" Text="{Binding KeepLastImages, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 6. СТРАНИЦА: ДИАГНОСТИКА И ЛОГИ (С ПОДРОБНЫМИ СВЕДЕНИЯМИ ОБО ВСЕХ ЭКРАНАХ) -->
                        <StackPanel Visibility="{Binding IsPageDiagnostics, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Stretch">
                            <TextBlock Text="Диагностика и логи" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Проверка сетевого подключения, параметры всех мониторов и журнал событий" Style="{StaticResource PageSubtitle}"/>

                            <!-- Сеть и API -->
                            <TextBlock Text="СЕТЬ И СЕРВИСЫ" Style="{StaticResource SectionGroupHeader}"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
